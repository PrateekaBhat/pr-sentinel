# Where your local Ollama server is running. Start it with `ollama serve`
# (it also runs automatically in the background after installing the Ollama app).
OLLAMA_BASE_URL=http://localhost:11434

# Which local model to use for analysis. Pull it first with e.g.:
#   ollama pull llama3.1
# Good options for this task, roughly fastest -> most capable:
#   llama3.2        (3B,  fastest, runs fine on a laptop CPU, less reliable JSON)
#   llama3.1         (8B,  good default balance of speed/quality)
#   mistral          (7B,  fast alternative)
#   llama3.1:70b     (70B, best quality, needs a strong GPU / lots of RAM)
OLLAMA_MODEL=llama3.2

# Embedding model used to index repository docs (README, architecture docs) for RAG.
# Pull it first: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# Repository RAG (retrieval over the target repo's own docs). Set to false to skip doc
# indexing entirely and speed up analysis.
RAG_ENABLED=true
# Where the local ChromaDB index is persisted between runs (one collection per repo).
CHROMA_PERSIST_DIR=./chroma_data

# Optional. Without it, GitHub limits you to 60 unauthenticated requests/hour per IP.
# With a token (no special scopes needed for public repos), you get 5,000/hour.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173
